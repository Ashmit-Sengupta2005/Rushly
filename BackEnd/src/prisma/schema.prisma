generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

// ENUM

enum OrderStatus {
  PENDING // created, before reservation confirmed
  RESERVED // stock held, awaiting payment
  PAID // payment succeeded via webhook
  FULFILLED // shipped / delivered
  CANCELLED // cancelled before payment
  REFUNDED // fully refunded post-payment
}

enum ReservationStatus {
  PENDING // active hold, waiting for payment
  PAID // converted into an order
  EXPIRED // TTL hit, Redis holds released
  CANCELLED // user cancelled explicitly
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SaleStatus {
  SCHEDULED // future, waiting-room accepting entries
  ACTIVE // currently running, admissions happening
  ENDED // over — successful or sold out
  CANCELLED
}
