# Backend API origin.
#   Local dev: http://localhost:4000 (BackEnd runs on PORT=4000)
#   Production (Vercel): DON'T SET IT. vercel.json proxies /api/* to Render, so the
#   API is same-origin and the httpOnly refresh cookie keeps working.
VITE_API_URL=http://localhost:4000

# Stripe publishable key (safe to expose in the browser; never put the secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Google Sign-In OAuth client ID (public; same value as BackEnd's GOOGLE_CLIENT_ID).
# Leave unset to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
